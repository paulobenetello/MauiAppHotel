<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label 
            Text="Cálculo da diária"
            FontFamily="CauseVariable"
            FontSize="50"
            TextColor="{StaticResource MidnightBlue}"/>

        <Frame Padding="10"
               BackgroundColor="{StaticResource Gray300}">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos"/>
                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource MidnightBlue}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>
                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>

                    <Label Grid.Row="1" Grid.Column="0"
                            Text="Crianças"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource MidnightBlue}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>
                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>
                </Grid>

                <Label Text="Escolha a sua suíte"/>
                <Picker x:Name="pck_quarto"
                        Title="Selecione sua acomodação"
                        ItemDisplayBinding="{Binding Descricao}"/>

                <Frame Padding="10"
                       Margin="10"
                       BackgroundColor="{StaticResource Gray200}">
                    <VerticalStackLayout>
                        <Label Text="Escolha sua estadia"/>
                        <HorizontalStackLayout>
                            <Label Text=" Chek-in:"/>
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text=" Chek-out:"/>
                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar"
                        BackgroundColor="{StaticResource MidnightBlue}"
                        Clicked="Button_Clicked" Margin="10"/>

                <Button Text="Sobre Nós"
                        BackgroundColor="{StaticResource MidnightBlue}"
                        Clicked="Button_Clicked2" Margin="10"/>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
    
</ContentPage>