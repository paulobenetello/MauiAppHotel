<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout VerticalOptions="CenterAndExpand">
        <Label Text="Suite Presidencial"
               TextColor="{StaticResource MidnightBlue}"
               FontFamily="CauseVariable"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Frame Margin="5"
               BackgroundColor="{StaticResource Gray300}">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos: "/>
                    <Label Text="2"/>
                </HorizontalStackLayout>
                
                <HorizontalStackLayout>
                    <Label Text="Crianças: "/>
                    <Label Text="2"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="5"
               BackgroundColor="{StaticResource Gray300}">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in: "/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out: "/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: "/>

                <Label Grid.Row="1" Grid.Column="0" Text="21/05/26"/>
                <Label Grid.Row="1" Grid.Column="1" Text="31/05/26"/>
                <Label Grid.Row="1" Grid.Column="2" Text="10"/>
            </Grid>
        </Frame>

        <Frame Margin="5"
               BackgroundColor="{StaticResource Gray300}">
            <HorizontalStackLayout>
                <Label Text="Valor Total: "/>
                <Label Text="R$500,00"/>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="voltar" HorizontalOptions="Center" 
                Clicked="Button_Clicked" 
                BackgroundColor="{StaticResource MidnightBlue}" 
                Padding="10"/>
    </VerticalStackLayout>
</ContentPage>