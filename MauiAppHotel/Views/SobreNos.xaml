<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.SobreNos"
             Title="SobreNos"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label 
            Text="Sobre"
            FontFamily="CauseVariable"
            FontSize="50"
            TextColor="{StaticResource MidnightBlue}"/>

        <Frame Padding="10"
               Background="{StaticResource Gray300}">
            <VerticalStackLayout>
                <Label Text="Esse é um teste de site de reservas de quartos em hoteis. Obrigado por Testar!"
                        FontSize="30"/>
                <Label Text="Criado por Paulo Benetello em 2026."
                       FontFamily="OpenSansSemibold"
                       FontSize="15"
                       TextColor="{StaticResource Gray100}"
                       HorizontalOptions="Center"
                       Margin="10"/>
            </VerticalStackLayout>
        </Frame>
        
    </VerticalStackLayout>
</ContentPage>