<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.TelaInicial"
             Title="TelaInicial"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                     Padding="10">
        <Label 
        Text="Faça Sua Reserva!"
        FontFamily="CauseVariable"
        FontSize="50"
        TextColor="{StaticResource MidnightBlue}"
        HorizontalOptions="Center"
        FontAttributes="Bold"/>

        <Frame Padding="10"
               Background="{StaticResource Gray300}"
               Margin="10">
            <VerticalStackLayout>
                <Label Text="Reserve sua estadia no melhor hotel do estado de São Paulo!"
                       FontSize="20"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>

        <Button Text="Avançar" HorizontalOptions="Center" 
                Clicked="Button_Clicked" 
                BackgroundColor="{StaticResource MidnightBlue}" 
                />
    </VerticalStackLayout>
</ContentPage>